# 서버 포트 (배포 플랫폼이 자동으로 넣어주는 경우가 많음)
PORT=3000

# 전원 공용 접속 비밀번호
SHARED_PASSWORD=change_this_shared_password

# 관리자 전용 비밀번호 (로그인 화면에서 "관리자" 토글 후 입력)
ADMIN_PASSWORD=change_this_admin_password

# 세션 쿠키 서명에 쓰는 비밀키. 반드시 길고 무작위한 문자열로 바꿀 것.
# 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# production으로 두면 쿠키에 secure 플래그가 붙습니다 (HTTPS 배포 시 필수)
# 로컬에서 http://localhost로 테스트할 때는 이 줄을 지우거나 development로 두세요.
NODE_ENV=production

# (선택) DB와 업로드 이미지를 다른 경로에 저장하고 싶을 때만 설정.
# Render 등에서 영구 디스크를 마운트했다면 그 경로를 지정하면 됩니다.
# DATA_DIR=/var/data/db
# UPLOAD_DIR=/var/data/uploads
